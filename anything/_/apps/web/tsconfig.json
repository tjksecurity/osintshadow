{
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.js",
		"**/*.jsx",
		"**/.server/**/*",
		"**/.client/**/*",
		".react-router/types/**/*",
		"./src/global.d.ts"
	],
	"exclude": ["node_modules", "build", ".bun-cache", ".vitest"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "vite/client"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"baseUrl": ".",
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"allowJs": true,
		"checkJs": false,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
